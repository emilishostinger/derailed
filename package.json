{
  "name": "derailed",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --parallel",
    "lint": "biome check . && bun run scripts/check-style.ts",
    "format": "biome format --write .",
    "check:style": "bun run scripts/check-style.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "^1.3.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.0"
  }
}
